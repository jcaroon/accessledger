[Unit]
Description=AccessLedger fictional access-request demo
After=network.target
[Service]
User=accessledger
Group=accessledger
WorkingDirectory=/opt/accessledger/current
ExecStart=/opt/accessledger/current/AccessLedger.Api
Environment=ASPNETCORE_URLS=http://127.0.0.1:39510
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DataDirectory=/var/lib/accessledger
StateDirectory=accessledger
StateDirectoryMode=0700
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/var/lib/accessledger
MemoryMax=512M
TasksMax=128
[Install]
WantedBy=multi-user.target
